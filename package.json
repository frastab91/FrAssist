{
  "name": "personal-assistant-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "dev": "concurrently \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "hosts": "node backend/scripts/run_fb_hosts.js",
    "hosts:dry": "node backend/scripts/run_fb_hosts.js --dry-run",
    "chrome": "open -a \"Google Chrome\" --args --remote-debugging-port=9222 --user-data-dir=\"$HOME/Library/Application Support/Google/Chrome/FrAssist\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
